# ---------------------------------------------------------------------------
# DPDMS environment variables. Copy this file to "dpdms.env" (which git
# ignores), fill in your values, then run scripts/start-all.ps1.
# Credentials are never hard-coded in the source; every service reads them
# from these variables.
# ---------------------------------------------------------------------------

# MySQL password for user root (all services use their own schema)
DB_PASSWORD=change-me

# Shared JWT signing secret - at least 32 characters, same for every service
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# --- Email alerts. Leave MAIL_HOST empty: alerts are logged as SIMULATED.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_USERNAME=your Gmail address,
#        MAIL_PASSWORD=a 16-character App Password (Google account > Security > App passwords)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- WhatsApp alerts via WhatsApp Business Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
# WHATSAPP_TOKEN = the access token, WHATSAPP_PHONE_NUMBER_ID = the "Phone number ID" (not the phone number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- OR WhatsApp alerts via Green API (green-api.com, free Developer plan).
# In the Green API console: create an instance, scan the QR code with WhatsApp,
# then copy apiUrl, idInstance and apiTokenInstance here. When these three are
# set, Green API is used instead of the Meta Cloud API above.
GREENAPI_API_URL=
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=

# --- Who receives the alerts (updated on every start of alert-service).
# The phone must include the country code, e.g. +2637XXXXXXXX
ALERT_DEMO_EMAIL=duty.officer@example.org
ALERT_DEMO_PHONE=+263770000000

# --- Alert thresholds
FLOOD_DANGER_LEVEL_M=3.0
DROUGHT_CROP_FAILURE_PCT=50
