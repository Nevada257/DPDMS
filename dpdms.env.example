# ---------------------------------------------------------------------------
# DPDMS environment variables. Copy this file to "dpdms.env" (which git
# ignores), fill in your values, then run scripts/start-all.ps1.
# Credentials are never hard-coded in the source; every service reads them
# from these variables.
# ---------------------------------------------------------------------------

# MySQL password for user root (all services use their own schema)
DB_PASSWORD=change-me

# Shared JWT signing secret - at least 32 characters, same for every service
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# --- Email alerts (optional). Leave MAIL_HOST empty: alerts are logged as SIMULATED
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=dpdms-alerts@example.org

# --- WhatsApp alerts via WhatsApp Business Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Demo alert recipient seeded on first start of alert-service
ALERT_DEMO_EMAIL=duty.officer@example.org
ALERT_DEMO_PHONE=+263770000000

# --- Alert thresholds
FLOOD_DANGER_LEVEL_M=3.0
DROUGHT_CROP_FAILURE_PCT=50
